# ─────────────────────────────────────────────
# SECRETS — never commit these
# ─────────────────────────────────────────────

# Environment variable files — contain API keys
.env
.env.local
.env.development
.env.production
*.env

# Google Cloud credentials
credentials.json
service-account.json
*-service-account.json
application_default_credentials.json

