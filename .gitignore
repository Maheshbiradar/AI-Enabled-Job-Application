# ─────────────────────────────────────────────

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Compiled Python files
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
MANIFEST
.eggs/
wheels/

